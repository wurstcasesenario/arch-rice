#!/usr/bin/env bash
set -euo pipefail

require_hypridle() {
	if ! command -v hypridle >/dev/null 2>&1; then
		echo "Error: hypridle is not installed." >&2
		exit 1
	fi
}

usage() {
	echo "Usage:"
	echo "  idlectl active"
	echo "  idlectl deactivate"
	echo "  idlectl toggle"
	echo "  idlectl status"
}

notify() {
	command -v notify-send >/dev/null 2>&1 || return 0
	notify-send "$@"
}

is_running() {
	pgrep -x hypridle >/dev/null 2>&1
}

start_idle() {
	require_hypridle

	if is_running; then
		echo "hypridle is already running."
		return
	fi

	hypridle &
	disown

	echo "hypridle started."
	notify "Idle" "hypridle activated"
}

stop_idle() {
	if ! is_running; then
		echo "hypridle is not running."
		return
	fi

	pkill -x hypridle

	echo "hypridle stopped."
	notify "Idle" "hypridle deactivated"
}

status_idle() {
	if is_running; then
		echo "true"
	else
		echo "false"
	fi
}

toggle_idle() {
	if is_running; then
		stop_idle
	else
		start_idle
	fi
}

main() {
	if [[ $# -ne 1 ]]; then
		usage
		exit 1
	fi

	case "$1" in
		active)
			start_idle
			;;
		deactivate)
			stop_idle
			;;
		toggle)
			toggle_idle
			;;
		status)
			status_idle
			;;
		*)
			usage
			exit 1
			;;
	esac
}

main "$@"